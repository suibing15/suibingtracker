# Copy this file to .env.local and fill in your Supabase project's values.
# Project Settings → API in your Supabase dashboard has all three.

# Public — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Used exclusively by app/api/admin/** route handlers
# to create/delete/reset accounts. Never prefix this with NEXT_PUBLIC_, and
# never import lib/supabaseAdmin.ts from a "use client" component.
SUPABASE_SERVICE_ROLE_KEY=
