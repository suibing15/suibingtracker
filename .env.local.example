# Copy this file to .env.local and fill in your Supabase project's values.
# Project Settings → API in your Supabase dashboard has all three.

# Public — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Used exclusively by app/api/admin/** route handlers
# to create/delete/reset accounts. Never prefix this with NEXT_PUBLIC_, and
# never import lib/supabaseAdmin.ts from a "use client" component.
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (Web Push / VAPID). Generate your own pair with:
#   npx web-push generate-vapid-keys
# The public key is safe to ship to the browser; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suibing15@gmail.com

# SECRET — shared secret Vercel Cron sends as "Authorization: Bearer <this>"
# when it calls /api/cron/daily-alerts. Generate any random string, e.g.:
#   openssl rand -hex 24
CRON_SECRET=
